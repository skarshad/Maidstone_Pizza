{
  "name": "maidstone-pizza",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > packages/types/src/database.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "turbo": "^2.11.10",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
