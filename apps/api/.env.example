# apps/api — SERVER ONLY. Copy to .env.local for local dev; set in Vercel for deploys.
# Never put these in web, admin, kitchen or mobile.

# Supabase project URL (Dashboard > Connect)
SUPABASE_URL=
# Publishable key (sb_publishable_...). Used to verify user tokens.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) / service role. Bypasses RLS. Server only.
SUPABASE_SECRET_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Shared secret Vercel Cron sends as "Authorization: Bearer <secret>". Without it the
# scheduled endpoints (/v1/cron/*) are switched off.
CRON_SECRET=

# ---- Payments ----
# Stripe (test mode while building). All three are needed; with any missing,
# Stripe is not used. Dashboard > Developers > API keys, and the signing secret
# of the webhook endpoint (see docs/DEPLOYMENT.md, section 6).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Without Stripe keys, "true" switches on the built-in payment simulator so the
# whole order flow can be tried with no card. Ignored in production.
PAYMENTS_SIMULATOR=

# ---- Email ----
# Resend API key. Without it, emails are not sent (a line is logged instead).
RESEND_API_KEY=
# Sender shown on emails. The domain must be verified in Resend.
EMAIL_FROM=Maidstone Pizza <orders@maidstonepizza.co.uk>

# Public address of the customer website, used for links in emails.
PUBLIC_SITE_URL=http://localhost:3000
# Optional. Signs guest order links; defaults to a value derived from the secret key.
ORDER_TOKEN_SECRET=
SENTRY_DSN=
