# apps/admin — PUBLIC values only. Everything here ships to the browser.
# Copy to .env.local for local dev; set in Vercel for deploys.
# Never add secret keys (Supabase secret key, Stripe secret key) to this app.

# Supabase project URL and publishable key (Dashboard > Connect)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of apps/api
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public URL of this app (used for auth redirects and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
